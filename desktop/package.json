{
  "name": "dadao-quant",
  "version": "1.0.0",
  "description": "大道量化投研平台 · 桌面端",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "build:all": "npm run build && npm run electron:build",
    "postinstall": "node scripts/rename-electron.js"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.1",
    "echarts": "^6.0.0",
    "three": "^0.183.2",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.dadao.quant",
    "productName": "大道量化投研平台",
    "copyright": "Copyright © 2025 大道量化",
    "directories": {
      "output": "../build/dist"
    },
    "files": [
      "electron/**",
      "frontend/dist/**",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": "electron/resources/python-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.icns",
      "category": "public.app-category.finance",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ]
    },
    "dmg": {
      "title": "大道量化投研平台",
      "sign": false
    }
  }
}
